<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- KeyService checks whether the screen in front is an activity of the HDMI app. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The vendor settings app carries the Allwinner display classes the root helper loads. -->
    <queries>
        <package android:name="com.mylove.setting" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.Projector">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FocusActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- See-through picture panel; its own task, so over HDMI it never brings the main Projector screen along. -->
        <activity
            android:name=".PictureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape"
            android:taskAffinity=""
            android:theme="@style/Theme.Projector.Overlay" />

        <!-- directBootAware: Android skips a service that is not while the user is still locked at boot and then
             drops it from the enabled list (the cleanyourtv launcher hit the same on Android 11+). -->
        <service
            android:name=".KeyService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/key_service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
